<UserControl x:Class="FESScript.Graphics.Windows.Constructors.Window"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FESScript.Graphics.Windows.Constructors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="200" x:Name="mainWindow" DataContext="{Binding ElementName=mainWindow}" KeyDown="mainWindow_KeyDown">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="local:Window.Highlight">
            <BeginStoryboard>
                <BeginStoryboard.Storyboard>
                    <Storyboard x:Name="HighlightStoryboard">
                        <ThicknessAnimation BeginTime="0:0:0" Storyboard.TargetName="topBorder" Storyboard.TargetProperty="BorderThickness" Duration="0:0:0.5" To="5, 5, 5, 0">
                            <ThicknessAnimation.EasingFunction>
                                <QuinticEase EasingMode="EaseInOut"/>
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                        <ThicknessAnimation BeginTime="0:0:3" Storyboard.TargetName="topBorder" Storyboard.TargetProperty="BorderThickness" Duration="0:0:2" To="0, 0, 0, 0">
                            <ThicknessAnimation.EasingFunction>
                                <QuinticEase EasingMode="EaseInOut"/>
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>

                        <ThicknessAnimation BeginTime="0:0:0" Storyboard.TargetName="bottomBorder" Storyboard.TargetProperty="BorderThickness" Duration="0:0:0.5" To="5, 0, 5, 5">
                            <ThicknessAnimation.EasingFunction>
                                <QuinticEase EasingMode="EaseInOut"/>
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                        <ThicknessAnimation BeginTime="0:0:3" Storyboard.TargetName="bottomBorder" Storyboard.TargetProperty="BorderThickness" Duration="0:0:2" To="0, 0, 0, 0">
                            <ThicknessAnimation.EasingFunction>
                                <QuinticEase EasingMode="EaseInOut"/>
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                    </Storyboard>
                </BeginStoryboard.Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid Name="grid">
        <Border x:Name="topBorder" Background="LightGray" CornerRadius="25, 25, 0, 0" BorderBrush="Red"/>
        <Border x:Name="bottomBorder" Background="White" Grid.Row="1" BorderBrush="Red"/>
        <ContentControl Content="{Binding DataContent}" Grid.Row="1" Background="LightGray" Margin="15"/>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
    </Grid>
</UserControl>
