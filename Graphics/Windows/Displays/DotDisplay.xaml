<dataDisplays:DataDisplay x:Class="FESScript.Graphics.Windows.Displays.DotDisplay"
             xmlns:dataDisplays="clr-namespace:FESScript.Graphics.Windows.Constructors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:templates="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.Templates" 
             xmlns:local="clr-namespace:FESScript.Graphics.Windows.Displays"
             d:DataContext="{d:DesignInstance Type=templates:DotTemplate}"
             mc:Ignorable="d" 
             d:DesignHeight="360" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="40"/>
            <RowDefinition MinHeight="40"/>
            <RowDefinition MinHeight="40"/>
            <RowDefinition MinHeight="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">ID:</Label>
        <Label Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Name:</Label>
        <Label Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Description:</Label>
        <Label Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">Type:</Label>
        <Label Grid.Column="0" Grid.Row="4" VerticalAlignment="Center">IO:</Label>
        <TextBox Grid.Column="1" Grid.Row="0" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" MaxLines="1" Text="{Binding ID, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="1" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" MaxLines="1" Text="{Binding Name, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="2" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" Text="{Binding Description, Mode=TwoWay}"/>
        <ComboBox Grid.Column="1" Grid.Row="3" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" ItemsSource="{Binding Source={StaticResource TypeEnum}}" SelectedItem="{Binding Type, Mode=TwoWay}"/>
        <ComboBox Grid.Column="1" Grid.Row="4" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" ItemsSource="{Binding Source={StaticResource IOEnum}}" SelectedItem="{Binding IO, Mode=TwoWay}" SelectionChanged="IOChanged"/>
    </Grid>   
</dataDisplays:DataDisplay>
              
              
              
              
              