<dataDisplays:DataDisplay x:Class="FESScript.Graphics.Windows.Displays.BlockDisplay"
             xmlns:dataDisplays="clr-namespace:FESScript.Graphics.Windows.Constructors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:templates="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.Templates" 
             xmlns:local="clr-namespace:FESScript.Graphics.Windows.Displays"
             d:DataContext="{d:DesignInstance Type=templates:BlockTemplate}"
             mc:Ignorable="d" 
             d:DesignHeight="360" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition MinHeight="40" Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">ID:</Label>
        <Label Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Name:</Label>
        <Label Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Description:</Label>
        <Label Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">Type:</Label>
        <Label Grid.Column="0" Grid.Row="4" VerticalAlignment="Center">Function Code:</Label>
        <Label Grid.Column="0" Grid.Row="5" VerticalAlignment="Center">Line Code:</Label>
        <Label Grid.Column="0" Grid.Row="6" VerticalAlignment="Top" Margin="0, 10">Dots:</Label>
        <Label Grid.Column="0" Grid.Row="7" VerticalAlignment="Top" Margin="0, 10">Contents:</Label>
        <TextBox Grid.Column="1" Grid.Row="0" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" MaxLines="1" Text="{Binding ID, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="1" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" MaxLines="1" Text="{Binding Name, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="2" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" Text="{Binding Description, Mode=TwoWay}"/>
        <ComboBox Grid.Column="1" Grid.Row="3" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" ItemsSource="{Binding Source={StaticResource TypeEnum}}" SelectedItem="{Binding Type, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="4" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" Text="{Binding InFunctionBodyCode, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="5" MinHeight="30" VerticalAlignment="Center" Margin="10, 5" Text="{Binding InLineBodyCode, Mode=TwoWay}"/>
        <Grid Grid.Column="1" Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <ItemsControl Name="DotsPanel" VerticalAlignment="Center" Margin="10, 5" ItemsSource="{Binding Dots, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="hoj">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding Name}" Click="EditDot" Padding="5, 2.5" MinHeight="30" Margin="10, 5" Grid.Column="0"/>
                            <Button Content="X" Click="DotDelete" Grid.Column="1" Width="25" Height="25" Margin="5"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Content="Add Dot" MinHeight="30" Margin="10, 5" Click="AddDotClick" Grid.Row="1"/>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <ItemsControl Name="ContentsPanel" VerticalAlignment="Center" Margin="10, 5" ItemsSource="{Binding Contents, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding Name}" Click="EditContent" Padding="5, 2.5" MinHeight="30" Margin="10, 5" Grid.Column="0"/>
                            <Button Content="X" Click="ContentDelete" Grid.Column="1" Width="25" Height="25" Margin="5"/>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Content="Add Content" MinHeight="30" Margin="10, 5" Click="AddContentClick" Grid.Row="1"/>
        </Grid>
    </Grid>   
</dataDisplays:DataDisplay>
              
              
              
              
              