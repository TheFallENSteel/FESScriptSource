<dataDisplays:DataDisplay x:Class="FESScript.Graphics.Windows.Displays.ContentDisplay"
             xmlns:dataDisplays="clr-namespace:FESScript.Graphics.Windows.Constructors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:templates="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.Templates" 
             xmlns:local="clr-namespace:FESScript.Graphics.Windows.Displays"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=templates:ContentTemplate}"
             mc:Ignorable="d" 
             d:DesignHeight="360" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="40"/>
            <RowDefinition MinHeight="40"/>
            <RowDefinition MinHeight="40"/>
            <RowDefinition MinHeight="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">ID:</Label>
        <Label Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Name:</Label>
        <Label Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Description:</Label>
        <Label Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">Type:</Label>
        <Label Grid.Column="0" Grid.Row="4" VerticalAlignment="Center">InitialValue:</Label>
        <TextBox Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" MinHeight="30" Margin="2.5" MaxLines="1" Text="{Binding ID, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" MinHeight="30" Margin="2.5" MaxLines="1" Text="{Binding Name, Mode=TwoWay}"/>
        <TextBox Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" MinHeight="30" Margin="2.5" Text="{Binding Description, Mode=TwoWay}"/>
        <ComboBox Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" MinHeight="30" Margin="2.5" ItemsSource="{Binding Source={x:Static templates:ContentTemplate.ContentTemplates}}" SelectedItem="{Binding Type, Mode=TwoWay}" SelectionChanged="ComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="sys:Type">
                    <Label Content="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" MinHeight="30" Margin="2.5" Text="{Binding InitialValue.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"/>
    </Grid>   
</dataDisplays:DataDisplay>
              
              
              
              
              