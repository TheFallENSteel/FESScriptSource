<Window x:Class="FESScript.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FESScript"
        xmlns:UserControls="clr-namespace:FESScript.Graphics.UserControls"
        xmlns:Tools="clr-namespace:FESScript.Tools"
        xmlns:SubUserControls="clr-namespace:FESScript.Graphics.UserControls.SubUserControls"
        mc:Ignorable="d"
        WindowStyle="None"
        Height="900" Width="1600" MinWidth="800" MinHeight="450" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" MouseDown="Window_MouseDown" MouseMove="Window_MouseMove" IsTabStop="False" Background="WhiteSmoke" MouseWheel="Window_MouseWheel" Loaded="Window_Loaded">
    <Grid x:Name="grid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel x:Name="DockPanel">
            
        </DockPanel>
        <Canvas Background="WhiteSmoke" Grid.Column="2" Grid.Row="2" x:Name="mainCanvas" Width="Auto" Height="Auto"/>
        <SubUserControls:Menu Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="5" x:Name="menu" IsTabStop="False"/>
        <Tools:CustomTitleBar x:Name="title" TitleText="{Binding MainWindow.SaveName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="999" ShutDownApp="True"/>
        <Tools:CustomLeftBar Grid.Column="0" Grid.Row="1" Grid.RowSpan="999"/>
    </Grid>
</Window>

