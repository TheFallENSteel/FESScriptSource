<UserControl x:Class="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Block"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.UserElements"
             xmlns:command="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Commands"
             xmlns:FESScript="clr-namespace:FESScript" xmlns:placements="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.Placements" d:DataContext="{d:DesignInstance Type=placements:BlockPlacement}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Width="auto" Height="auto" 
             MouseRightButtonDown="UserControl_MouseRightButtonDown"
             MouseRightButtonUp="MouseButtonUp" Background="Transparent">
    <Grid IsHitTestVisible="True" Name="BlockElement">
        <Border CornerRadius="7.5" Background="{Binding Background, ElementName=Border}" MinHeight="25" Grid.ColumnSpan="99999" Grid.RowSpan="99999" BorderThickness="5" BorderBrush="Gray" IsHitTestVisible="True">
            <Border x:Name="Border" CornerRadius="7.5" Background="{Binding BlockTemplate.Type, Converter={StaticResource TypeToBrushConverter}}" MinHeight="25" Grid.ColumnSpan="99999" Grid.RowSpan="99999" Margin="-2" IsHitTestVisible="True"/>
        </Border>
        <ItemsControl 
            x:Name="InDotsPanel" 
            ItemsSource="{Binding DotPlacements, Converter={StaticResource IOFilter}, ConverterParameter={x:Static FESScript:IO.Input}, NotifyOnSourceUpdated=True}"
            Grid.Column="0"
            Margin="7.5, 5, 2.5, 5"
            IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl 
        x:Name="ContentPanel" 
        ItemsSource="{Binding ContentPlacements, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Grid.Column="1"
        Margin="2.5, 5"
        IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:ContentData">
                        <ContentControl x:Name="Control" Content="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl 
            x:Name="OutDotsPanel" 
            ItemsSource="{Binding DotPlacements, Converter={StaticResource IOFilter}, ConverterParameter={x:Static FESScript:IO.Output}}"
            Grid.Column="2"
            Margin="2.5, 5, 7.5, 5"
            IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            <!--
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="local:DotData">
                    <ContentControl Content="{Binding ., Converter={StaticResource TypeToContentConverter}}"/>
                    <local:Dot MouseDownHandler="MouseDown" MouseUpHandler="MouseUp"></local:Dot>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            -->
            </ItemsControl>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="DeleteBlock" Click="MenuItem_Click"/>
            <MenuItem Header="Duplicate" Click="MenuItem_Click"/>
            <MenuItem Header="Reset" Click="MenuItem_Click"/>
            <MenuItem Header="Edit" Click="MenuItem_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
</UserControl>
