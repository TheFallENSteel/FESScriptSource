<UserControl x:Class="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Dot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.UserElements"
             xmlns:UserControls="clr-namespace:FESScript.Graphics.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid RenderTransformOrigin="0.5,0.5" Margin="0.5">
        <Ellipse x:Name="ellipse" Stroke="Gray" Fill="{Binding Type, Converter={StaticResource TypeToBrushConverter}, Mode=TwoWay}" StrokeThickness="2" Width="15" Height="15"/>
        <UserControls:ConnectorPoint VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Connector" IsTabStop="False"/>
    </Grid>
</UserControl>
