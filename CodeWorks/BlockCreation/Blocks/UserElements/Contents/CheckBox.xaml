<UserControl x:Class="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Contents.CheckBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Contents.CheckBox" 
             xmlns:placements="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.Placements" 
             d:DataContext="{d:DesignInstance Type=placements:ContentPlacement}"
             mc:Ignorable="d" 
             d:DesignWidth="300" MinWidth="15">
    <Grid Height="25" Width="auto" MaxWidth="300">
        <CheckBox x:Name="checkBox"
                  VerticalAlignment="Center"
                  Margin="5,0"
                  IsChecked="{Binding Path=Value.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
    </Grid>
</UserControl>

