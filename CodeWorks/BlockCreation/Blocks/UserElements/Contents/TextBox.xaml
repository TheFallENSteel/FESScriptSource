<UserControl x:Class="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Contents.TextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Contents.TextBox"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Grid Height="25" Width="auto" MaxWidth="300">
        <Border Background="White" BorderBrush="Gray" BorderThickness="2" CornerRadius="7.5"/>
        <TextBox 
            Background="Transparent"
            BorderThickness="0" 
            MinWidth="25" 
            MaxLines="1" 
            x:Name="textBox" 
            Margin="2.5, 5" 
            Padding="2.5, 0"
            VerticalAlignment="Center" 
            Focusable="True"
            HorizontalAlignment="Stretch"
            Style="{StaticResource Text}" 
            Text="{Binding Value.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
            IsTabStop="False"/>
    </Grid>
</UserControl>
