<UserControl x:Class="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Contents.TextLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FESScript.Graphics.UserControls.SubUserControls"
             xmlns:placements="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.Placements"
             d:DataContext="{d:DesignInstance Type=placements:ContentPlacement}"
             mc:Ignorable="d" 
             d:DesignWidth="800" MinWidth="15">
    <Grid Height="25" Width="auto" MaxWidth="300">
        <TextBlock x:Name="text"
                   Width="auto"
                   VerticalAlignment="Center"
                   Margin="5,0"
                   Style="{StaticResource TextsBlock1}"
                   Text="{Binding DirectValue.Value, Mode=TwoWay}"/>
    </Grid>
</UserControl>
