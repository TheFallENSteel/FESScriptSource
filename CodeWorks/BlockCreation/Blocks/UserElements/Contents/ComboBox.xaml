<UserControl x:Class="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Contents.Combobox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="FESScript.CodeWorks.BlockCreation.Blocks.UserElements.Contents.Combobox" 
             xmlns:placements="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks.Placements" 
             d:DataContext="{d:DesignInstance Type=placements:ContentPlacement}"
             mc:Ignorable="d" 
             d:DesignWidth="300" MinWidth="15">
    <Grid Height="40" Width="auto" MaxWidth="300">
        <ComboBox 
            MaxWidth="200"
            
            x:Name="comboBox"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Center"
            Margin="7.5,5"
            BorderThickness="0"
            MinWidth="20"
            Height="25"
            VerticalContentAlignment="Center"
            SelectedIndex="{Binding Value.SelectedIndex,  UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
            ItemsSource=  "{Binding Value.Values,         UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
        </ComboBox>
    </Grid>
</UserControl>