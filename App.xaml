<Application x:Class="FESScript.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FESScript"
             xmlns:blockCreation="clr-namespace:FESScript.CodeWorks.BlockCreation"
             xmlns:blocks="clr-namespace:FESScript.CodeWorks.BlockCreation.Blocks"
             xmlns:tools="clr-namespace:FESScript.Tools"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:FES="clr-namespace:FESScript"
             xmlns:CodeExec="clr-namespace:FESScript.CodeWorks.CodeExecution"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose"
             >

    <Application.Resources>
        <Style x:Key="TextsControl1" TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="TextsBlock1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <Style x:Key="TextsLabel1" TargetType="Label">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <Style x:Key="DotButton1" TargetType="Ellipse">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <DataTemplate DataType="{x:Type blockCreation:Category}" x:Key="CategoryNameShower">
            <Grid>
                <Label Content="{Binding Name}" HorizontalAlignment="Center" FontFamily="Arial" MouseDown="BlockViewer_OnMouseDown"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="Text" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <blocks:TypeToContentConverter x:Key="TypeToContentConverter"></blocks:TypeToContentConverter>
        <local:TypeToBrushConverter x:Key="TypeToBrushConverter"></local:TypeToBrushConverter>
        <local:IOFilter x:Key="IOFilter"></local:IOFilter>
        <tools:DividerConverter x:Key="DividerConverter"></tools:DividerConverter>
        <ObjectDataProvider x:Key="TypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="FES:Type"></x:Type>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="IOEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="FES:IO"></x:Type>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="CompilersEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="CodeExec:CompilerEnum"></x:Type>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TranpilersEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="CodeExec:TranspilerEnum"></x:Type>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Application.Resources>
</Application>
